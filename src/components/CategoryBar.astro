---
import { getCollection } from 'astro:content';

interface Props {
  /** Slug of the category being viewed; omit on /blog ("All Categories" active). */
  current?: string;
}
const { current } = Astro.props;
// Same order as the Webflow category list.
const order = ['privacy', 'data-sharing'];
const categories = (await getCollection('categories')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<nav class="category-bar" aria-label="Blog categories">
  <a href="/blog" class="pill" aria-current={!current ? 'page' : undefined}>All Categories</a>
  {
    categories.map((c) => (
      <a href={`/category/${c.id}`} class="pill" aria-current={current === c.id ? 'page' : undefined}>
        {c.data.name}
      </a>
    ))
  }
</nav>

<style>
  .category-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .pill:hover {
    border-color: var(--teal);
  }

  .pill[aria-current='page'] {
    border-color: var(--teal);
    background: var(--teal);
    color: #fff;
  }
</style>
