---
/** The shared "Let's work together" block from the Webflow site. Its email form became a mailto link. */
import { EMAIL, mailto } from '../data/site';
---

<section class="section cta grid-lines" aria-labelledby="cta-heading">
  <div class="container">
    <div class="cta__inner reveal">
      <div class="cta__copy">
        <p class="eyebrow eyebrow--rule">speak with the team today</p>
        <h2 id="cta-heading" class="h2">Let's work together</h2>
        <p class="lede">Talk to us today about streamlining your data reporting</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={mailto('Medicly enquiry')}>
            {EMAIL} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="cta__mark" aria-hidden="true">
        <img src="/media/medicly-icon.svg" width="256" height="256" alt="" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(45% 70% at 85% 50%, rgb(255 255 255 / 0.85), transparent 70%),
      radial-gradient(40% 60% at 0% 0%, rgb(226 245 244 / 0.9), transparent 70%),
      var(--lavender);
  }

  .cta__inner {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .cta__copy > * + * {
    margin-top: 20px;
  }

  .cta__copy .btn-row {
    margin-top: 32px;
  }

  .cta__mark {
    justify-self: center;
    width: min(320px, 70vw);
  }

  .cta__mark img {
    width: 100%;
    filter: drop-shadow(0 24px 48px rgb(20 54 81 / 0.18));
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
</style>
