---
/** 1px-hairline stat grid with count-up numbers (final values are in the HTML for no-JS / crawlers). */
interface Stat {
  label?: string;
  value: string;
  text: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<ul class="stats reveal" role="list">
  {
    stats.map((s) => (
      <li class="stat">
        {s.label && <p class="stat__label">{s.label}</p>}
        <p class="stat__value" data-count={s.value}>
          {s.value}
        </p>
        <p class="stat__text">{s.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .stats {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--hair-dark);
    background: var(--hair-dark);
  }

  @media (min-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 36px 28px;
    background: var(--navy);
  }

  .stat__label {
    font: 500 0.6875rem/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal-soft);
  }

  .stat__value {
    margin: 0;
    font-size: clamp(2.6rem, 4.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--coral);
  }

  .stat__text {
    max-width: 24ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--on-dark-60);
  }
</style>

<script>
  // Count up from 0 once each grid is half visible. Skipped for reduced motion / paused motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const paused = () => document.documentElement.dataset.motion === 'paused';
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

  function run(el: HTMLElement) {
    const target = el.dataset.count!;
    const m = target.match(/^([\d.]+)(.*)$/);
    if (!m) return;
    const end = parseFloat(m[1]);
    const decimals = (m[1].split('.')[1] ?? '').length;
    const suffix = m[2];
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 2000);
      el.textContent = (end * easeOutExpo(t)).toFixed(decimals) + suffix;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = target;
    };
    requestAnimationFrame(step);
  }

  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          if (!paused()) e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(run);
        }
      },
      { threshold: 0.5 },
    );
    document.querySelectorAll('.stats').forEach((g) => io.observe(g));
  }
</script>
