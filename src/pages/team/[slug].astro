---
import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((member) => ({ params: { slug: member.id }, props: { member } }));
}

const { member } = Astro.props;
const bio = member.body?.trim() ?? '';
const og = await getImage({ src: member.data.photo, width: 800, format: 'png' });
---

<Base title={member.data.name} description={bio} ogImage={og.src}>
  <section class="member glow-hero grid-lines">
    <div class="container container--narrow member__inner">
      <a href="/about-us" class="back rise"><span aria-hidden="true">←</span> Back</a>
      <span class="member__photo rise" style={`background-color: ${member.data.background}`}>
        <Image src={member.data.photo} alt={member.data.name} width={480} loading="eager" />
      </span>
      <h1 class="h1 rise" style="--i: 1">{member.data.name}</h1>
      <p class="eyebrow rise" style="--i: 1">{member.data.role}</p>
      <p class="lede rise" style="--i: 2">{bio}</p>
      <a class="link-arrow rise" style="--i: 3" href={member.data.linkedin} target="_blank" rel="noopener">
        <img src="/media/linkedin-icon-fill.svg" width="20" height="20" alt="" /> LinkedIn <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .member {
    position: relative;
    isolation: isolate;
    padding: 56px 0 112px;
  }

  @media (min-width: 640px) {
    .member {
      padding: 72px 0 144px;
    }
  }

  .member__inner {
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }

  .member__inner .lede {
    margin-inline: auto;
  }

  .back {
    justify-self: start;
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--navy);
  }

  .member__photo {
    display: block;
    width: 200px;
    height: 200px;
    margin-block: 16px 8px;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: var(--shadow-card-hover);
  }

  .member__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  .link-arrow img {
    width: 20px;
  }
</style>
