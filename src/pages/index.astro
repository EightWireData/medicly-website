---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import StatGrid from '../components/StatGrid.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import YouTube from '../components/YouTube.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image } from 'astro:assets';
import geoffrey from '../assets/images/geoffrey-sayer.jpeg';

const partners = [
  { src: '/media/snowflake.svg', alt: 'Snowflake', width: 184, height: 44 },
  { src: '/media/indici.svg', alt: 'Indici', width: 150, height: 47 },
  { src: '/media/medtech-logo.svg', alt: 'Medtech', width: 214, height: 80 },
  { src: '/media/mypractice.svg', alt: 'MyPractice', width: 288, height: 74 },
];

const features = [
  {
    icon: { src: '/media/compliant-coloured.svg', width: 128, height: 147 },
    title: 'Compliance out of the box',
    text: 'Reduce privacy and security costs with security controls met by Medicly for you.',
  },
  {
    icon: { src: '/media/blazingfast-coloured.svg', width: 164, height: 133 },
    title: 'Blazing fast from start to finish',
    text: 'Algorithm-based data sharing means no more writing and testing code.',
  },
  {
    icon: { src: '/media/interoperability-coloured.svg', width: 139, height: 148 },
    title: 'The hard work is done',
    text: 'Matching and transforming data from the PMS to your analytics platform is done for you.',
  },
];

const stats = [
  { value: '80+', text: 'Existing customers utilising our Data Exchange platform' },
  { value: '4000', text: 'Data records delivered securely per second' },
  { value: '3.5b', text: 'Data records delivered every month' },
  { value: '80%', text: 'Faster to implement than comparable solutions' },
];
---

<Base
  title="Medicly | Healthcare Data Exchange"
  description="Consolidating data across the healthcare sector. An automated data exchange that aggregates from multiple practice management systems, more speedy and securely than ever before so you can focus on your analytics and Business Intelligence reporting."
  ogImage="/media/medicly-opengraph-01.png"
>
  <!-- Hero -->
  <section class="hero glow-hero grid-lines hairline">
    <div class="container split">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--pill rise"><span class="pulse-dot"></span>HEALTHY DATA MANAGEMENT</p>
        <h1 class="display rise" style="--i: 1">An all-round solution for <em>sensitive health data exchange</em></h1>
        <p class="lede rise" style="--i: 2">
          Health and social systems across the world can access primary care data faster and more securely than ever before with Medicly.
        </p>
        <div class="btn-row rise" style="--i: 3">
          <a class="btn btn--primary" href="/contact">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero__media rise" style="--i: 2">
        <img src="/media/medicly-header-illo.svg" width="658" height="464" alt="" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section dark glow-dark-center grid-lines">
    <div class="container">
      <SectionHead layout="center" eyebrow="INNOVATING HEALTHCARE" title="It's time to introduce us to your data team" />
      <div class="video-frame reveal">
        <YouTube id="eTpz4mo8NrM" title="Medicly - New Zealand Health data exchange" />
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="partners" aria-labelledby="partners-heading">
    <h2 id="partners-heading" class="eyebrow eyebrow--caption">Trusted partners with</h2>
    <LogoMarquee logos={partners} repeat={3} />
  </section>

  <!-- Features -->
  <section class="section glow-mint">
    <div class="container">
      <SectionHead
        eyebrow="data sharing that just works"
        title="Deliver primary care analytics <em>today</em>"
        lede="A no-fuss, quick setup process that lets you get to your primary care reporting and analytics sooner."
      >
        <a class="link-arrow" href="/about-us">Find out more <span class="arrow" aria-hidden="true">→</span></a>
      </SectionHead>
      <ul class="ruled feature-list" role="list">
        {
          features.map((f, i) => (
            <li class="ruled__item reveal" style={`--i: ${i}`}>
              <span class="index" aria-hidden="true">/ 0{i + 1}</span>
              <img class="feature-icon" src={f.icon.src} width={f.icon.width} height={f.icon.height} alt="" loading="lazy" />
              <h3 class="h3">{f.title}</h3>
              <p class="body">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Stats -->
  <section class="section dark glow-dark grid-lines">
    <div class="container">
      <SectionHead
        layout="center"
        eyebrow="DAtA EXCHANGe"
        title="The fastest, most secure way to access <em>primary care data</em>"
        lede="Automated, integrated data across entire primary healthcare networks for easy analytics and collaboration."
      />
      <StatGrid stats={stats} />
    </div>
  </section>

  <!-- Connect, Map, Exchange -->
  <section class="section section--white">
    <div class="container split split--media-first">
      <div class="stack reveal" style="--stack: 24px">
        <p class="eyebrow eyebrow--rule">it just works</p>
        <h2 class="h2">Connect, Map, <em>Exchange.</em></h2>
        <p class="lede">A no-fuss, quick setup process that lets you get to your primary care reporting and analytics sooner.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/get-started">Get started <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="reveal" style="--i: 1">
        <img class="connect__img" src="/media/doc-with-child-mum.svg" width="338" height="333" alt="" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--ice">
    <div class="container">
      <SectionHead layout="center" eyebrow="TESTIMONIALS" title="Don't just take our <br class='br-lg' />word for it" />
      <div class="quotes">
        <figure class="card quote reveal">
          <blockquote>
            <p>
              "For the healthcare sector, Eightwire (and its secure data exchange), has the potential to become a critical tool that will
              enable the secure and timely exchange of sensitive patient information between healthcare providers."
            </p>
          </blockquote>
          <figcaption>
            <img class="quote__logo" src="/media/mohlogo-blue.svg" width="629" height="298" alt="Manatū Hauora Ministry of Health" loading="lazy" />
            <p class="quote__who"><strong>MANATŪ HAUORA<br /><em>MINISTRY OF HEALTH</em></strong></p>
          </figcaption>
        </figure>
        <figure class="card quote reveal" style="--i: 1">
          <blockquote>
            <p>
              "As a Medtech Certified Partner, Medicly has undergone stringent testing to build health-specific data transfer technology that
              safeguards your PMS data privacy and security. Medicly works seamlessly with your PMS, ensuring that data is secure in transit
              and is only used for the specific purpose for which it has been approved. "
            </p>
          </blockquote>
          <figcaption>
            <Image class="quote__photo" src={geoffrey} alt="Geoffrey Sayer" width={112} height={112} />
            <p class="quote__who"><strong>GEOFFREY SAYER<br /><em>CEO, MedTECH GLOBAL</em></strong></p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: 56px 0 72px;
  }

  @media (min-width: 640px) {
    .hero {
      padding: 80px 0 104px;
    }
  }

  .hero__copy > * + * {
    margin-top: 24px;
  }

  .hero__copy .btn-row {
    margin-top: 36px;
  }

  .hero__media img {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }

  .video-frame {
    max-width: 1040px;
    margin-inline: auto;
  }

  .partners {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  .partners h2 {
    margin-bottom: 32px;
  }

  .feature-icon {
    width: auto;
    height: 88px;
  }

  .connect__img {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }

  .quotes {
    display: grid;
    gap: 24px;
    max-width: 1040px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .quotes {
      grid-template-columns: 1fr 1fr;
    }
  }

  .quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 36px;
  }

  .quote blockquote {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--navy);
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .quote__logo {
    width: 88px;
    height: auto;
  }

  .quote__photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .quote__who {
    font-size: 0.8125rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .quote__who strong {
    font-weight: 600;
  }

  .quote__who em {
    font-weight: 400;
    color: var(--muted);
  }

  @media (max-width: 767px) {
    :global(.br-lg) {
      display: none;
    }
  }
</style>
