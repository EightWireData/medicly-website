---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { Image, getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { getPosts } from '../../lib/blog';
import { formatDate } from '../../lib/format';
import { AUTHOR, EMAIL, mailto } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const category = (await getEntry(post.data.category))!;
// Webflow's Related Articles listed every post, the current one included.
const related = posts;
const og = await getImage({ src: post.data.image, width: 1200, format: 'jpg' });
---

<Base title={post.data.title} description={post.data.summary} ogImage={og.src}>
  <article>
    <header class="post-hero glow-hero grid-lines">
      <div class="container container--narrow post-hero__inner">
        <a href="/blog" class="back rise">
          <span aria-hidden="true">←</span> Back
        </a>
        <a href={`/category/${category.id}`} class="badge rise">{category.data.name}</a>
        <h1 class="h1 rise" style="--i: 1">{post.data.title}</h1>
        <p class="lede rise" style="--i: 2">{post.data.summary}</p>
        <p class="byline rise" style="--i: 3">
          <span class="avatar avatar--mark" aria-hidden="true">
            <img src="/media/medicly-icon.svg" width="256" height="256" alt="" />
          </span>
          <span>
            <span class="byline__name">{AUTHOR}</span>
            <time class="byline__date" datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
          </span>
        </p>
      </div>
    </header>

    <div class="container post-cover rise" style="--i: 3">
      <Image src={post.data.image} alt={post.data.title} width={1600} loading="eager" />
    </div>

    <div class="container container--narrow post-body">
      <div class="prose">
        <Content />
      </div>


      <section class="subscribe" aria-labelledby="subscribe-heading">
        <h2 id="subscribe-heading" class="h2-sm">Enjoyed this read?</h2>
        <p class="body">Stay up to date with the latest video business news, strategies, and insights sent straight to your inbox!</p>
        <a class="btn btn--primary" href={mailto('Subscribe to Medicly updates')}>{EMAIL} <span class="arrow" aria-hidden="true">→</span></a>
      </section>
    </div>
  </article>

  <section class="section section--ice" aria-labelledby="related-heading">
    <div class="container">
      <h2 id="related-heading" class="h2-sm related-heading">Related Articles</h2>
      <ul class="related" role="list">
        {
          related.map((p) => (
            <li>
              <PostCard post={p} variant="compact" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .post-hero {
    position: relative;
    isolation: isolate;
    padding: 48px 0 56px;
  }

  @media (min-width: 640px) {
    .post-hero {
      padding: 72px 0 72px;
    }
  }

  .post-hero__inner {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .back {
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--navy);
  }

  .byline {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
    color: var(--navy);
    text-decoration: none;
  }

  .byline__name {
    display: block;
    font-weight: 600;
  }

  .byline__date {
    display: block;
    font: 400 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .avatar {
    display: block;
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
  }

  .avatar--mark {
    display: grid;
    place-items: center;
    background: var(--white);
    box-shadow: var(--shadow-card);
  }

  .avatar--mark img {
    width: 34px;
    height: 34px;
  }

  .post-cover :global(img) {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card-hover);
  }

  .post-body {
    padding-block: 64px 96px;
  }

  .subscribe {
    display: grid;
    justify-items: start;
    gap: 16px;
    margin-top: 56px;
    padding: 40px;
    border-radius: var(--radius-md);
    background:
      radial-gradient(50% 80% at 100% 0%, rgb(255 255 255 / 0.8), transparent 70%),
      var(--lavender);
  }

  .related-heading {
    margin-bottom: 32px;
  }

  .related {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
