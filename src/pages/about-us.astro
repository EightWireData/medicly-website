---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import StatGrid from '../components/StatGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const heroLede =
  'We understand that the healthcare sector needs quick, reliable access to primary care data. We are focused on delivering data from any PMS in the country while removing the technical and compliance costs that get in the way.';

const stats = [
  { label: 'USED BY', value: '80+', text: 'Customers across APAC' },
  { label: 'DELIVERING', value: '4000', text: 'Records securely per second' },
  { label: 'TRANSFERRING', value: '3.5b', text: 'Data records per month' },
  { label: 'simple', value: '80%', text: 'Faster to implement than other solutions' },
];

const values = [
  {
    icon: { src: '/media/speed-coloured.svg', width: 141, height: 116 },
    title: 'Speed',
    text: "Quick setup and 80% reduction in efforts to integrate on-premise data stores means you'll see a difference right away.",
  },
  {
    icon: { src: '/media/security-coloured.svg', width: 138, height: 87 },
    title: 'Security',
    text: 'We meet the highest security thresholds required for data sharing on the public internet.',
  },
  {
    icon: { src: '/media/ingoodhands-coloured.svg', width: 146, height: 96 },
    title: 'Governance',
    text: 'An end-to-end data exchange that integrates management and security capabilities to provide the visibility and control you require.',
  },
];

// Same order as the Webflow team list.
const order = ['andy-ellis', 'jason-gleason'];
const team = (await getCollection('team')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<!-- The Webflow meta description here was leftover template text ("Felix is the ultimate product…"),
     so the page's own hero paragraph is used instead. -->
<Base title="About us - Medicly" description={heroLede}>
  <PageHero
    eyebrow="ABOUT US"
    title="We want to make health data sharing <em>easier and more secure</em>"
    lede={heroLede}
    image={{ src: '/media/medicly-header-illo.svg', width: 658, height: 464 }}
  />

  <section class="section dark glow-dark grid-lines">
    <div class="container">
      <SectionHead
        layout="center"
        eyebrow="powered by eightwire"
        title="You'll be in <em>great company</em>"
        lede="We automate the thousands of steps needed to deliver data between enterprises."
      />
      <StatGrid stats={stats} />
    </div>
  </section>

  <section class="section glow-mint">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <p class="eyebrow eyebrow--rule">THE promised land</p>
        <div class="section-head__body">
          <h2 class="h2">Automated and secure <em>health data sharing</em></h2>
          <p class="lede">
            We've seen data challenges across our healthcare sector for a long time. The reality is that health systems are complex and
            fragile to build and maintain. They also effect everyone across the health and social services sectors.<br /><br />Medicly
            evolved from these frustrations and the risks that come with them. Our focus is to use innovative software to remove the
            challenges of accessing primary care data for analytics. We’ve done this through focusing on what health and social systems
            require and forcing technology to work for our communities.
          </p>
        </div>
      </div>
      <ul class="ruled" role="list">
        {
          values.map((v, i) => (
            <li class="ruled__item reveal" style={`--i: ${i}`}>
              <span class="index" aria-hidden="true">/ 0{i + 1}</span>
              <img class="value-icon" src={v.icon.src} width={v.icon.width} height={v.icon.height} alt="" loading="lazy" />
              <h3 class="h3">{v.title}</h3>
              <p class="body">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <SectionHead eyebrow="TEAM" title="We're a <em>passionate</em> bunch" />
      <ul class="team" role="list">
        {
          team.map((m, i) => (
            <li class="card card--hover team-card reveal" style={`--i: ${i}`}>
              <a href={`/team/${m.id}`} class="team-card__photo" style={`background-color: ${m.data.background}`} aria-label={m.data.name}>
                <Image src={m.data.photo} alt="" width={600} />
              </a>
              <div class="team-card__body">
                <div>
                  <h3 class="h3">
                    <a href={`/team/${m.id}`}>{m.data.name}</a>
                  </h3>
                  <p class="body">{m.data.role}</p>
                </div>
                <a href={m.data.linkedin} class="team-card__social" target="_blank" rel="noopener" aria-label={`${m.data.name} on LinkedIn`}>
                  <img src="/media/linkedin-icon-fill.svg" width="24" height="24" alt="" />
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .value-icon {
    width: auto;
    height: 80px;
  }

  .team {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .team {
      grid-template-columns: repeat(2, minmax(0, 340px));
    }
  }

  .team-card {
    overflow: hidden;
  }

  .team-card__photo {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .team-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
    transition: transform 0.6s var(--ease-out);
  }

  .team-card:hover .team-card__photo :global(img) {
    transform: scale(1.04);
  }

  .team-card__body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
  }

  .team-card__body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .team-card__social img {
    width: 24px;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .team-card__social:hover img {
    opacity: 1;
  }
</style>
