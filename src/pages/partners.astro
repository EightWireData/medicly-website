---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image } from 'astro:assets';
import synergia from '../assets/images/synergia-logo.png';
import medtech from '../assets/images/medtechlogo.png';
import snowflake from '../assets/images/snowflake-logo.png';
import dha from '../assets/images/dha-logo.png';

const partners = [
  { name: 'Impact Lab', svg: { src: '/media/impactlab-logo.svg', width: 412, height: 86 } },
  { name: 'Synergia', img: synergia },
  { name: 'Medtech Global', img: medtech },
  { name: 'Snowflake', img: snowflake },
  { name: 'Digital Health Association', img: dha },
];
---

<Base
  title="Partners | Medicly"
  description="We deliver an innovative software solution that allows enterprises to share sensitive data faster and more securely than ever before. We work with some of the world's most exciting public and private organisations to drastically reduce the time, costs, and risk of sharing data."
>
  <PageHero
    eyebrow="Our Partners"
    title="Trusted by our <em>partners</em>"
    lede="Our range of partners include technology partners and commercial partners. Our partners help us deliver our Data Delivery Service to more business and often simplify the onboarding process for our customers."
  />

  <section class="section section--white">
    <div class="container">
      <ul class="partner-grid" role="list">
        {
          partners.map((p, i) => (
            <li class="card card--hover partner reveal" style={`--i: ${i}`}>
              <div class="partner__logo">
                {p.svg ? (
                  <img src={p.svg.src} width={p.svg.width} height={p.svg.height} alt="" loading="lazy" />
                ) : (
                  <Image src={p.img!} alt="" width={480} />
                )}
              </div>
              <h2 class="partner__name">{p.name}</h2>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .partner-grid {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .partner-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .partner-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .partner {
    display: flex;
    flex-direction: column;
  }

  .partner__logo {
    display: grid;
    place-items: center;
    height: 180px;
    padding: 32px 40px;
    border-bottom: 1px solid var(--line);
  }

  .partner__logo :is(img) {
    width: auto;
    max-width: 100%;
    max-height: 72px;
    object-fit: contain;
  }

  .partner__name {
    padding: 20px 24px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
